{
  "name": "api-admin-foodtag",
  "version": "1.0.0",
  "private": true,
  "description": "API del panel de super admin de FoodTag: registra los restaurantes (tenants) y los administra en sus instancias.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node -r tsconfig-paths/register src/server.ts\"",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "create-admin": "ts-node -r tsconfig-paths/register scripts/create-admin.ts",
    "check:modules": "ts-node -r tsconfig-paths/register scripts/check-modules.ts",
    "typeorm": "ts-node -r tsconfig-paths/register -e \"require('typeorm/cli')\"",
    "test": "npm run check:modules"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
