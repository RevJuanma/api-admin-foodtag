PORT=4000
NODE_ENV=development

# Base de datos propia del panel (distinta de la de cualquier restaurante)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password
DB_NAME=foodtag_admin

# Sesión del panel (32+ caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Clave con la que se cifran en la base los tokens de las instancias (32+ caracteres). Si se pierde, hay que volver a cargar los tokens.
ADMIN_SECRET_KEY=

# Orígenes del panel web permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5174

# Permite registrar instancias con http:// (solo para desarrollo o redes privadas)
ALLOW_INSECURE_INSTANCES=true

# ── Aprovisionamiento de instancias (crear un restaurante levanta su propia instancia) ──
# docker = el panel crea y administra las instancias con Docker; vacío = solo se registran instancias que ya existen
PROVISIONER=
# Dirección de cada instancia: <slug>.<INSTANCE_BASE_DOMAIN>. foodtag.com es provisorio.
INSTANCE_BASE_DOMAIN=foodtag.com
INSTANCE_SCHEME=https
# host = <slug>.<dominio> detrás de Traefik (producción); port = cada restaurante en su puerto de este equipo, http://localhost:4100, 4101… (desarrollo, sin DNS ni proxy; usar INSTANCE_BASE_DOMAIN=localhost e INSTANCE_SCHEME=http)
INSTANCE_ROUTING=host
INSTANCE_PORT_START=4100
# Solo si el proxy no escucha en el puerto estándar (ej. 8088 en desarrollo)
INSTANCE_PUBLIC_PORT=
# Imagen de la API de los restaurantes (docker build -t foodtag-api:local ../api-foodtag)
INSTANCE_IMAGE=foodtag-api:local
# Red de Docker en la que viven el proxy (Traefik), el Postgres y las instancias
INSTANCE_NETWORK=foodtag
INSTANCE_ENTRYPOINT=websecure
INSTANCE_CERT_RESOLVER=
# Carpeta con el build de la web de gestión (npm run build:instance en app-foodtag); se monta en cada instancia
INSTANCE_WEB_DIR=
# port = el panel habla con las instancias por un puerto en 127.0.0.1 (panel fuera de Docker); network = por el nombre del contenedor
INSTANCE_CONTROL_MODE=port

# Postgres donde se crea una base (y un usuario) por restaurante
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASS=
# Cómo llegan las instancias al Postgres desde la red de Docker
TENANT_DB_INTERNAL_HOST=db
TENANT_DB_INTERNAL_PORT=5432
# Contenedor del Postgres (de ahí se hacen los respaldos con pg_dump)
TENANT_DB_CONTAINER=

# Respaldos
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Hora local del respaldo diario automático (0-23); -1 lo apaga
BACKUP_HOUR=3
# Cada cuántos segundos el panel revisa la salud de las instancias
MONITOR_INTERVAL_SECONDS=120
